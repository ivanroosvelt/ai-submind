{
  "name": "@tejo/core",
  "private": true,
  "version": "0.1.0",
  "description": "Lexer, parser, workspace y render a SVG del lenguaje .flo (paquete interno de tejo).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanroosvelt/tejo.git",
    "directory": "packages/core"
  },
  "keywords": [
    "diagram",
    "flowchart",
    "sequence-diagram",
    "parser",
    "svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3",
    "@types/dagre": "^0.7.52",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
