exports[`reference diagrams (visual snapshot) > renders a flowchart with a single node and no edges 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="160" height="90" viewBox="0 0 160 90"><defs><marker id="flo-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#1f2937" /></marker></defs><g><rect x="20" y="20" width="120" height="50" rx="0" fill="#eff6ff" stroke="#1f2937" stroke-width="2" /><text x="80" y="45" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="14">Nodo unico</text></g></svg>"`;

