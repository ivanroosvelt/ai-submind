{
  "name": "ai-submind",
  "version": "0.0.0",
  "private": true,
  "description": "Local manager for knowledge diagrams versioned in knowledge/, with an MCP server and a web UI",
  "type": "module",
  "bin": {
    "ai-submind": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deps && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  }
}
