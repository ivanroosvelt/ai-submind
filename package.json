{
  "name": "ai-submind",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Local manager for knowledge diagrams versioned in knowledge/, with an MCP server and a web UI",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "uml",
    "diagrams",
    "knowledge",
    "ai-agents",
    "git"
  ],
  "author": "Iván López",
  "homepage": "https://github.com/ivanroosvelt/ai-submind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanroosvelt/ai-submind.git"
  },
  "bugs": {
    "url": "https://github.com/ivanroosvelt/ai-submind/issues"
  },
  "type": "module",
  "bin": {
    "ai-submind": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "spec/format/README.md",
    "spec/format/schema",
    "spec/format/migrations",
    "NOTICE",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build --logLevel warn",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/ui/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deps && npm test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@joint/core": "4.3.3",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  }
}
