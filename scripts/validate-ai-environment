#!/usr/bin/env python3
"""Validates the AI orchestration environment.

Checks entry points, adapters, the agent/skill registry and its native
format, capabilities and coverage, environment decisions, plans, reports,
the ID ledger, references and duplication.

Usage: scripts/validate-ai-environment [--strict]
Exit: 0 without errors, 1 with errors.
"""
import argparse
import sys

from smtools.common import Report, repo_root
from smtools.env import check_environment


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--strict", action="store_true", help="treat warnings as errors")
    args = ap.parse_args()
    report = Report()
    check_environment(repo_root(), report)
    print(report.render("AI environment", strict=args.strict))
    return 1 if report.errors or (args.strict and report.warnings) else 0


if __name__ == "__main__":
    sys.exit(main())
