#!/usr/bin/env python3
"""Valida el entorno de orquestación de IA.

Comprueba puntos de entrada, adaptadores, registro de agentes/skills y su
formato nativo, capacidades y cobertura, decisiones del entorno, planes,
informes, ledger de IDs, referencias y duplicidades.

Uso: scripts/validate-ai-environment [--strict]
Salida: 0 sin errores, 1 con errores.
"""
import argparse
import sys

from smtools.common import Report, repo_root
from smtools.env import check_environment


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--strict", action="store_true")
    args = ap.parse_args()
    report = Report()
    check_environment(repo_root(), report)
    print(report.render("Entorno de IA", strict=args.strict))
    return 1 if report.errors or (args.strict and report.warnings) else 0


if __name__ == "__main__":
    sys.exit(main())
