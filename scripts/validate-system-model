#!/usr/bin/env python3
"""Validates the product structural model (docs/system/).

Usage: scripts/validate-system-model [--since <rev>] [--strict]
  --since <rev>  warn if the diff against <rev> touches code_roots without touching docs/system/
  --strict       treat warnings as errors
Exit: 0 without errors, 1 with errors.
"""
import argparse
import sys

from smtools.common import Report, repo_root
from smtools.model import check_model


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since")
    ap.add_argument("--strict", action="store_true")
    args = ap.parse_args()
    report = Report()
    model = check_model(repo_root(), report, since=args.since)
    n = len(model.elements) if model else 0
    print(report.render(f"Structural model ({n} element(s))", strict=args.strict))
    return 1 if report.errors or (args.strict and report.warnings) else 0


if __name__ == "__main__":
    sys.exit(main())
