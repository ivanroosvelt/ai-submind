#!/usr/bin/env python3
"""Regenerates the derived artifacts (never edited by hand):

- docs/system/inventory/INDEX.md      inventory of IDs and relations (English)
- docs/system/traceability/MATRIX.md  traceability matrix (English)
- .ai/registry/agents-index.md        agents index (Spanish environment doc)
- .ai/registry/skills-index.md        skills index (Spanish environment doc)
- .github/copilot-instructions.md     embedded AGENTS.md block

Usage: scripts/regen
"""
import argparse
import sys

from smtools.common import Report, repo_root
from smtools.env import regen_environment
from smtools.model import regen_model


def main() -> int:
    argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter).parse_args()
    root = repo_root()
    report = Report()
    changed = regen_model(root, report) + regen_environment(root, report)
    for c in changed:
        print(f"updated: {c}")
    if not changed:
        print("no changes")
    if report.errors:
        print(report.render("Regeneration errors"))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
